# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# system: OS packages, split into layers ordered from least to most volatile so
# that touching the tesseract language list doesn't rebuild libreoffice.
# ---------------------------------------------------------------------------
FROM python:3.14-slim AS system

ENV DEBIAN_FRONTEND="noninteractive"

LABEL org.opencontainers.image.title="Base image for FollowTheMoney File Ingestors"
LABEL org.opencontainers.image.licenses="AGPL3"
LABEL org.opencontainers.image.source="https://github.com/openaleph/ingest-file-base"

# Keep downloaded archives so the cache mount below survives between builds; the
# default docker-clean hook deletes them after every install. Package indexes
# are deliberately *not* cached: a stale list against a moved mirror gives
# "Hash Sum mismatch". Non-free is needed for `unrar`.
RUN rm -f /etc/apt/apt.conf.d/docker-clean \
    && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' >/etc/apt/apt.conf.d/keep-cache \
    && echo 'Acquire::Retries "3";' >/etc/apt/apt.conf.d/retries \
    && echo "deb http://http.us.debian.org/debian bookworm non-free" >/etc/apt/sources.list.d/nonfree.list

# Toolchain and core libraries. Needed to compile PyICU (and any dependency
# without a wheel), so it stays in the published image. No python3-* packages:
# this image already ships its own interpreter, debian's would be a second one.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get -qq -y update \
    && apt-get -qq -y install build-essential pkg-config locales ca-certificates git \
    libxslt1-dev libpq-dev libldap2-dev libsasl2-dev \
    zlib1g-dev libicu-dev libxml2-dev \
    # necessary for python-magic
    libmagic1 \
    && localedef -i en_US -c -f UTF-8 -A /usr/share/locale/locale.alias en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# pdf convert: libreoffice + a bunch of fonts. By far the largest layer and
# almost never edited, so it sits ahead of everything that changes.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get -qq -y update \
    && apt-get -qq -y install libreoffice fonts-opensymbol hyphen-fr hyphen-de \
    hyphen-en-us hyphen-it hyphen-ru fonts-dejavu fonts-dejavu-core fonts-dejavu-extra \
    fonts-droid-fallback fonts-dustin fonts-f500 fonts-fanwood fonts-freefont-ttf \
    fonts-liberation fonts-lmodern fonts-lyx fonts-sil-gentium fonts-texgyre \
    fonts-tlwg-purisa \
    && rm -rf /var/lib/apt/lists/*

# Document, image, archive and media tooling.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get -qq -y update \
    && apt-get -qq -y install \
    # package tools
    unrar \
    # audio & video metadata
    libmediainfo-dev \
    # image processing, djvu
    imagemagick-common imagemagick mdbtools djvulibre-bin \
    libtiff5-dev libjpeg-dev libfreetype6-dev libwebp-dev libgif-dev \
    libtiff-tools ghostscript librsvg2-bin jbig2dec \
    pst-utils ripmime \
    && rm -rf /var/lib/apt/lists/*

# Tesseract. The engine itself ships inside the tesserocr wheel, only the
# traineddata comes from debian. This list changes most often, so it goes last.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get -qq -y update \
    && apt-get -qq -y install tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-swa \
    tesseract-ocr-swe \
    # tesseract-ocr-tam \
    # tesseract-ocr-tel \
    tesseract-ocr-fil \
    # tesseract-ocr-tha \
    tesseract-ocr-tur \
    tesseract-ocr-ukr \
    # tesseract-ocr-vie \
    tesseract-ocr-nld \
    tesseract-ocr-nor \
    tesseract-ocr-pol \
    tesseract-ocr-por \
    tesseract-ocr-ron \
    tesseract-ocr-rus \
    tesseract-ocr-slk \
    tesseract-ocr-slv \
    tesseract-ocr-spa \
    # tesseract-ocr-spa_old \
    tesseract-ocr-sqi \
    tesseract-ocr-srp \
    tesseract-ocr-ind \
    tesseract-ocr-isl \
    tesseract-ocr-ita \
    # tesseract-ocr-ita_old \
    # tesseract-ocr-jpn \
    tesseract-ocr-kan \
    tesseract-ocr-kat \
    # tesseract-ocr-kor \
    tesseract-ocr-khm  \
    tesseract-ocr-lav \
    tesseract-ocr-lit \
    # tesseract-ocr-mal \
    tesseract-ocr-mkd \
    tesseract-ocr-mya \
    tesseract-ocr-mlt \
    tesseract-ocr-msa \
    tesseract-ocr-est \
    # tesseract-ocr-eus \
    tesseract-ocr-fin \
    tesseract-ocr-fra \
    tesseract-ocr-frk \
    # tesseract-ocr-frm \
    # tesseract-ocr-glg \
    # tesseract-ocr-grc \
    tesseract-ocr-heb \
    tesseract-ocr-hin \
    tesseract-ocr-hrv \
    tesseract-ocr-hye \
    tesseract-ocr-hun \
    # tesseract-ocr-ben \
    tesseract-ocr-bul \
    tesseract-ocr-cat \
    tesseract-ocr-ces \
    tesseract-ocr-nep \
    # tesseract-ocr-chi_sim \
    # tesseract-ocr-chi_tra \
    # tesseract-ocr-chr \
    tesseract-ocr-dan \
    tesseract-ocr-deu \
    tesseract-ocr-ell \
    # tesseract-ocr-enm \
    # tesseract-ocr-epo \
    # tesseract-ocr-equ \
    tesseract-ocr-afr \
    tesseract-ocr-ara \
    tesseract-ocr-aze \
    tesseract-ocr-bel \
    tesseract-ocr-uzb \
    && rm -rf /var/lib/apt/lists/*

# Set up the locale and make sure the system uses unicode for the file system.
ENV LANG='en_US.UTF-8' \
    TZ='UTC' \
    OMP_THREAD_LIMIT='1' \
    OPENBLAS_NUM_THREADS='1' \
    TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

RUN groupadd -g 1000 -r app \
    && useradd -m -u 1000 -s /bin/false -g app app

# ---------------------------------------------------------------------------
# wheels: PyICU publishes no wheels, so compile one here. Isolating it keeps
# the compile out of the final image's layers and lets it cache on its own.
# ---------------------------------------------------------------------------
FROM system AS wheels

RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 wheel --no-binary=:all: --wheel-dir /wheels pyicu

# ---------------------------------------------------------------------------
# base: the published image
# ---------------------------------------------------------------------------
FROM system AS base

RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install --prefer-binary --upgrade pip setuptools wheel

RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=bind,from=wheels,source=/wheels,target=/wheels \
    pip3 install /wheels/*.whl
